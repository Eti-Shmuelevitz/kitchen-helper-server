# העתיקי את הקובץ הזה לקובץ בשם .env ומלאי ערכים אמיתיים. אל תעלי את .env ל־GitHub.

# כתובת מסד הנתונים (PostgreSQL). אפשר להדביק כאן את הכתובת מ־Neon (ראו START-HERE.md),
# או כתובת של PostgreSQL מקומי, למשל:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kitchen?schema=public"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# מחרוזת סודית ארוכה (32 תווים לפחות). אפשר ליצור אחת עם:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-characters"

# תוקף הכניסה (7d = שבעה ימים)
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development

# כתובות האתר בריאקט שמותר להן לפנות לשרת, מופרדות בפסיק
CORS_ORIGINS="http://localhost:5173"

# הכתובת הציבורית של השרת (מוצגת בלוג)
PUBLIC_URL="http://localhost:4000"

# האתר סגור בשבת ובחג (זמני ירושלים). false רק אם צריך לעבוד על הקוד במוצאי שבת לפני צאת השבת לפי השעון של השרת
SHABBAT_GUARD=true
TIMEZONE="Asia/Jerusalem"

# לבדיקות האוטומטיות בלבד: מסד נפרד שנמחק בכל הרצה
TEST_DATABASE_URL=

# Production בלבד, לא חובה: יצירת בית הדגמה עם סיסמה משלך
SEED_DEMO_PASSWORD=
